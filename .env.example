PORT=4010
APP_NAME=FixNow

# SMTP settings for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fixnow@gmail.com
SMTP_PASS=
SMTP_FROM=FixNow <fixnow@gmail.com>

# Optional local fallback: if SMTP is missing, return resetLink in API response.
# Keep true for local testing; set false in production.
ALLOW_RESET_LINK_FALLBACK=true
