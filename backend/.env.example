PORT=4010
APP_NAME=FixNow

# SMTP settings for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fixnow@gmail.com
SMTP_PASS=
SMTP_FROM=FixNow <fixnow@gmail.com>

# Optional local fallback: if SMTP is missing, return resetLink in API response.
# Keep true for local testing; set false in production.
ALLOW_RESET_LINK_FALLBACK=true

# Render: NODE_ENV=production, DATA_DIR=/var/data/fixnow, fallback=false.
# Leave DATA_DIR unset locally to keep using backend/data.
# DATA_DIR=/var/data/fixnow
# PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
# ADMIN_WEB_URL=https://YOUR-ADMIN-SITE.onrender.com

# Supabase Session pooler connection string. Empty uses legacy local JSON storage.
DATABASE_URL=
# Optional CA certificate path, relative to backend/ or absolute.
# DATABASE_SSL_CA_FILE=certs/supabase-ca.crt
